{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Yarp": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        }
      },
      "basket-grpc-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/BasketApi.Basket/{**catch-all}"
        }
      },
      "webhooks-route": {
        "ClusterId": "webhooks-cluster",
        "Match": {
          "Path": "/api/webhooks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-api.eshop.local:8080"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering-api": {
            "Address": "http://ordering-api.eshop.local:8080"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket-api": {
            "Address": "http://basket-api.eshop.local:8080"
          }
        },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionExact"
        }
      },
      "webhooks-cluster": {
        "Destinations": {
          "webhooks-api": {
            "Address": "http://webhooks-api.eshop.local:8080"
          }
        }
      }
    }
  }
}
